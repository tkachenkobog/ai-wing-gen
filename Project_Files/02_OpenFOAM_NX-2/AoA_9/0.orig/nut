FoamFile
{
    version     2.0;
    format      binary;
    class       volScalarField;
    arch        "LSB;label=32;scalar=64";
    location    "3";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];


internalField   uniform 0.14;

boundaryField
{
    INLET
    {
        type            freestream;
        freestreamValue uniform 0.14;
    }    
    OUTLET
    {
        type            freestream;
        freestreamValue uniform 0.14;
    }
    WING
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
	SIDE
    {
        type            symmetry;
    }
    SIDE_S
    {
        type            symmetry;
    }	
    BOTTOM
    {
        type            freestream;
        freestreamValue uniform 0.14;
    }
    TOP
    {
        type            freestream;
        freestreamValue uniform 0.14;
    }

}


